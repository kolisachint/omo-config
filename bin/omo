#!/usr/bin/env node
/**
 * OMO - Oh My Openagent Config Manager
 * Portable profile switcher for opencode/oh-my-openagent
 *
 * Providers: codex, opencodego, githubcopilot, claude, gemini
 * Tiers: premium, daily, fast, free
 */

