function getProfileDir() {
  const tryPaths = [
    path.join(__dirname, '..', 'profiles'),
    path.join(__dirname, '..', '..', 'profiles'),
    path.join(process.cwd(), 'profiles')
  ];
  for (const p of tryPaths) {
    if (fs.existsSync(p)) return p;
  }
  return null;
}

function ensureConfigDir() {
  if (!fs.existsSync(CONFIG_DIR)) {
    fs.mkdirSync(CONFIG_DIR, { recursive: true });
  }
}

function backupCurrent() {
  if (!fs.existsSync(TARGET_FILE)) return;
  const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
  const backupPath = path.join(CONFIG_DIR, `oh-my-openagent.json.backup-${timestamp}`);
  fs.copyFileSync(TARGET_FILE, backupPath);
  return backupPath;
}

function getActiveProfile() {
  if (!fs.existsSync(TARGET_FILE)) return null;
  try {
    const stat = fs.lstatSync(TARGET_FILE);
    if (stat.isSymbolicLink()) {
      const link = fs.readlinkSync(TARGET_FILE);
      const base = path.basename(link, '.json');
      const match = base.match(/oh-my-openagent\.(.*)/);
      if (match) return match[1];
      return base;
    }
    const content = fs.readFileSync(TARGET_FILE, 'utf8');
    const profileDir = getProfileDir();
    if (profileDir) {
      for (const [name, info] of Object.entries(PROFILES)) {
        const pFile = path.join(profileDir, info.file);
        if (fs.existsSync(pFile)) {
          const pContent = fs.readFileSync(pFile, 'utf8');
          if (content.trim() === pContent.trim()) return name;
        }
      }
    }
    return 'custom';
  } catch (e) {
    return 'unknown';
  }
}

function switchProfile(name) {
  const profile = PROFILES[name];
  if (!profile) {
    console.error(`❌ Unknown profile: ${name}`);
    console.error(`Run 'omo list' to see available profiles.`);
    process.exit(1);
  }

  const profileDir = getProfileDir();
  if (!profileDir) {
    console.error('❌ Could not find profiles directory. Are you running from the repo?');
    process.exit(1);
  }

  const sourceFile = path.join(profileDir, profile.file);
  if (!fs.existsSync(sourceFile)) {
    console.error(`❌ Profile file not found: ${sourceFile}`);
    process.exit(1);
  }

  ensureConfigDir();
  const backup = backupCurrent();

  if (fs.existsSync(TARGET_FILE)) {
    fs.unlinkSync(TARGET_FILE);
  }

  fs.copyFileSync(sourceFile, TARGET_FILE);

  console.log(`✅ Switched to: ${name}`);
  console.log(`   ${profile.desc}`);
  console.log(`   Provider: ${profile.provider} | Cost: ${profile.cost}`);
  if (backup) {
    console.log(`   Backup: ${path.basename(backup)}`);
  }
}

function showList() {
  const active = getActiveProfile();
  console.log('\n📋 Available Profiles\n');

  const providers = ['OpenAI', 'OpenCode Go', 'GitHub Copilot', 'Anthropic', 'Google'];
  const tiers = ['premium', 'daily', 'fast', 'free'];

  for (const provider of providers) {
    console.log(`${provider}:`);
    for (const tier of tiers) {
      const entry = Object.entries(PROFILES).find(([, info]) => info.provider === provider && info.tier === tier);
      if (entry) {
        const [name, info] = entry;
        const marker = active === name ? '▶ ' : '  ';
        console.log(`  ${marker}${name.padEnd(24)} ${info.cost.padEnd(6)} ${info.desc}`);
      }
    }
    console.log('');
  }

  if (active) {
    console.log(`🟢 Active: ${active}`);
  }
  console.log('');
}

function showStatus() {
  const active = getActiveProfile();
  if (!active) {
    console.log('⚠️  No active profile found.');
    return;
  }
  const info = PROFILES[active] || { desc: 'Custom config', cost: '?', provider: 'Unknown' };
  console.log('\n📊 OMO Status\n');
  console.log(`Active profile: ${active}`);
  console.log(`Provider:       ${info.provider}`);
  console.log(`Description:    ${info.desc}`);
  console.log(`Cost tier:      ${info.cost}`);
  console.log(`Config path:    ${TARGET_FILE}`);
  console.log('');
}

function showCompare(args) {
  const active = getActiveProfile();
  const providers = args.length > 0 ? args : ['codex', 'opencodego', 'githubcopilot', 'claude', 'gemini'];

  console.log('\n🔍 Profile Comparison\n');

  for (const provider of providers) {
    const tiers = ['premium', 'daily', 'fast', 'free']
      .map(t => Object.entries(PROFILES).find(([name, info]) => name.startsWith(provider) && info.tier === t))
      .filter(Boolean);

    if (tiers.length === 0) continue;

    const providerLabel = tiers[0][1].provider;
    console.log(`${providerLabel.toUpperCase()}`);
    const names = tiers.map(([n]) => n);
    const prefix = names[0].split('-')[0];
    const header = '  Dimension'.padEnd(18) + names.map(n => n.replace(`${prefix}-`, '').padEnd(14)).join('');
    console.log(header);
    console.log('  ' + '-'.repeat(header.length - 2));

    console.log('  Cost'.padEnd(18) + names.map(n => PROFILES[n].cost.padEnd(14)).join(''));

    const profileDir = getProfileDir();
    const getPrimary = (name) => {
      const file = path.join(profileDir, PROFILES[name].file);
      try {
        const json = JSON.parse(fs.readFileSync(file, 'utf8'));
        return json.agents?.sisyphus?.model?.replace(/.*\//, '') || '-';
      } catch { return '-'; }
    };
    console.log('  Orchestrator'.padEnd(18) + names.map(n => getPrimary(n).padEnd(14)).join(''));

    const getQuick = (name) => {
      const file = path.join(profileDir, PROFILES[name].file);
      try {
        const json = JSON.parse(fs.readFileSync(file, 'utf8'));
        return json.categories?.quick?.model?.replace(/.*\//, '') || '-';
      } catch { return '-'; }
    };
    console.log('  Quick'.padEnd(18) + names.map(n => getQuick(n).padEnd(14)).join(''));

    const marker = n => active === n ? ' ← active' : '';
    console.log('  ' + names.map(n => `${n}${marker(n)}`).join(' | '));
    console.log('');
  }
}

function showHelp() {
  console.log(`
OMO - Oh My Openagent Config Manager

Usage:
  omo <profile>              Switch to a profile
  omo list                   List all profiles
  omo status                 Show current profile
  omo compare [providers]    Compare profiles (e.g. omo compare codex claude)
  omo setup                  Full setup
  omo help                   Show this help

Providers & Tiers:
  codex          premium / daily / fast / free
  opencodego     premium / daily / fast / free
  githubcopilot  premium / daily / fast / free
  claude         premium / daily / fast / free
  gemini         premium / daily / fast / free

Examples:
  omo codex-daily            Switch to OpenAI daily driver
  omo opencodego-fast        Switch to OpenCode Go fast mode
  omo gemini-premium         Switch to Gemini max quality
  omo compare                Compare all providers
  omo compare codex claude   Compare specific providers
`);
}

function runSetup() {
  ensureConfigDir();
  console.log('🔧 OMO Setup\n');
  console.log(`Config dir:  ${CONFIG_DIR}`);
  console.log(`Target file: ${TARGET_FILE}`);
  console.log('');

  const active = getActiveProfile();
  if (!active) {
    console.log('No active config found. Installing codex-daily as default...');
    switchProfile('codex-daily');
  } else {
    console.log(`Active profile: ${active}`);
  }

  console.log('\n✅ Setup complete!');
  console.log('   Run "omo list" to see all profiles');
  console.log('   Run "omo <profile>" to switch');
}

// Main
const args = process.argv.slice(2);
const cmd = args[0];

if (!cmd || cmd === 'help' || cmd === '--help' || cmd === '-h') {
  showHelp();
} else if (cmd === 'list') {
  showList();
} else if (cmd === 'status') {
  showStatus();
} else if (cmd === 'compare') {
  showCompare(args.slice(1));
} else if (cmd === 'setup') {
  runSetup();
} else if (PROFILES[cmd]) {
  switchProfile(cmd);
} else {
  console.error(`❌ Unknown command or profile: ${cmd}`);
  console.error(`Run 'omo help' for usage.`);
  process.exit(1);
}
