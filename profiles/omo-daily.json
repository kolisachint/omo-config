{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" }
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.4-mini"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "fallback_models": [
        { "model": "opencode-go/glm-5", "variant": "high" }
      ]
    },
    "librarian": {
      "model": "opencode-go/minimax-m2.7-highspeed"
    },
    "explore": {
      "model": "opencode-go/minimax-m2.7-highspeed"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" }
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" }
      ]
    },
    "metis": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" }
      ]
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "fallback_models": [
        { "model": "openai/gpt-5.4-mini" }
      ]
    },
    "atlas": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" }
      ]
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        { "model": "openai/gpt-5-nano" }
      ]
    }
