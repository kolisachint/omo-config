    "deep": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        { "model": "opencode-go/kimi-k2.5" }
      ]
    },
    "quick": {
      "model": "openai/gpt-5-nano"
    },
    "unspecified-low": {
      "model": "openai/gpt-5-nano"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.4-mini"
    },
    "writing": {
      "model": "openai/gpt-5.4-mini"
    }
